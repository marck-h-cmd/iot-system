# ============================================================================
# SMART COOLING IoT 2.0 — Variables de Entorno (.env.example)
# Universidad Nacional de Trujillo (UNT)
# ============================================================================

# Modo de operación del sistema: "simulacion" (sin hardware físico) o "hardware_real"
OPERATION_MODE=simulacion

# Modo del simulador Python: "5_zonas" (simulación completa) o "3_zonas" (cuando Arduino/ESP32 estén conectados)
SIMULATION_MODE=5_zonas
INITIAL_SCENARIO=demostracion
PUBLISH_INTERVAL_SEC=5.0

# Configuración Base de Datos MySQL
DB_HOST=mysql
DB_PORT=3306
DB_USER=iot_user
DB_PASSWORD=iot_password_2025
DB_NAME=iot_cooling_db

# Configuración Broker MQTT EMQX
MQTT_BROKER=emqx
MQTT_PORT=1883
MQTT_USER=sensor_iot
MQTT_PASS=marck124M

# URL Pública del Backend FastAPI para Frontend Web y App Móvil
NEXT_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_API_URL=http://192.168.0.23:8000

